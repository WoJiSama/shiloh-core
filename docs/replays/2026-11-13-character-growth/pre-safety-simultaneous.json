          "groupId": "99000002",
          "segments": [
            {
              "type": "text",
              "data": {
                "text": "再不放心就空烧试一下：只开上管，摸摸下面那根管热不热（小心烫）。说明书规格页一般也会写“上/下管独立控温”，翻一眼最准～"
              }
            }
          ]
        }
